+{# CUSTOM: Raven-branded override of flask_security/templates/security/base.html.
+   Applies to every Flask-Security fallback page (change password, forgot
+   password, etc.) that isn't handled by the React SPA, so they don't look
+   like a bare, unstyled default form. #}
+{% block doc -%}
+<!DOCTYPE html>
+<html{% block html_attribs %}{% endblock html_attribs %}>
+  {%- block html %}
+  <head>
